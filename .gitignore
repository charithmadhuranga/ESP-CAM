sdkconfig.esp32cam
sdkconfig

# --- Node / web UI ---
node_modules/
webui/dist/
npm-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- OS junk ---
.DS_Store
Thumbs.db
*~
*.swp

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
secrets.h
secrets.json

