# --- PlatformIO ---
.pio/
.pioenvs/
.piolibdeps/

# ESP-IDF generates this full resolved config on every build; the source of
# truth is sdkconfig.defaults (verified symbols recorded in
# docs/adr/0001-toolchain.md).
sdkconfig.esp32cam
sdkconfig

# --- ESP-IDF component manager ----------------------------------------------
# managed_components/ is downloaded build input (like node_modules/): the
# component manager re-fetches it from the registry on configure, so it is
# never committed.
#
# dependencies.lock IS committed — it is the exact-version pin for every
# dependency, including transitive ones the upstream manifests declare as
# ranges (esp32-camera@2.1.9 pulls espressif/esp_jpeg@^1.3.1, which would
# otherwise float). Together with firmware/src/idf_component.yml it satisfies
# AGENTS rule 24. Never delete it to "clean up".
managed_components/

# --- Node / web UI ---
node_modules/
webui/dist/
npm-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- IDE ---
.vscode/

# --- OS junk ---
.DS_Store
Thumbs.db
*~
*.swp

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
secrets.h
secrets.json

# --- Note ---
# reference/ is deliberately NOT ignored: it is pinned behavioural evidence.
# It is excluded from the firmware build and from release archives instead
# (see reference/README.md).
